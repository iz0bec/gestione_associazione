[Unit]
Description=Portale dei servizi (Gestione Associazione)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /root/gestione-associazione-src/scripts/portale/genera_portale.py /etc/portale-servizi/portale.toml --uscita /var/www/portale-servizi
