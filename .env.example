# Obbligatorie -----------------------------------------------------------
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DATABASE_URL=postgres://gestione:password@127.0.0.1:5432/gestione_associazione
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo in sviluppo
DEBUG=false

# HTTPS ------------------------------------------------------------------
# true se l'app è raggiungibile solo via https (cookie "secure")
HTTPS=false
# es. https://gestione.miassociazione.it (necessario dietro reverse proxy https)
CSRF_TRUSTED_ORIGINS=
# numero di reverse proxy fidati davanti all'app (0 = nessuno)
PROXY_COUNT=0

# Email in uscita ----------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Associazione <noreply@example.com>

# Percorsi (facoltativi) ---------------------------------------------------
# MEDIA_ROOT=/var/lib/gestione-associazione/media
# STATIC_ROOT=/var/lib/gestione-associazione/static

# Sicurezza accessi (facoltativi) ------------------------------------------
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_ORE=0.25
# SESSION_DURATA_SECONDI=28800
